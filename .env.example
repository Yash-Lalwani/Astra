# App
# APP_ENV: development | production
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated; add the Vercel URL in production
CORS_ORIGINS=http://localhost:3000
# Yash's key for review actions and uncapped runs
ADMIN_API_KEY=
# Live runs per UTC day for visitors without the admin key
PUBLIC_DAILY_RUN_LIMIT=5
# Delay between events when replaying a finished run
REPLAY_DELAY_MS=250

# Database (Neon: use the DIRECT, non-pooler connection string)
DATABASE_URL=
TEST_DATABASE_URL=postgresql://astra:astra@localhost:5434/astra_test

# LLMs (OpenRouter, used for every chat model call)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# Comma-separated provider slugs in priority order; no other provider is used
OPENROUTER_PROVIDERS=StreamLake,DeepInfra,DigitalOcean
# Supervisor + brief
STRONG_MODEL=deepseek/deepseek-v4-flash
# Specialists + rule writing
FAST_MODEL=deepseek/deepseek-v4-flash
# json_schema (function_calling fails on OpenRouter with require_parameters)
STRUCTURED_OUTPUT_METHOD=json_schema
LLM_REQUESTS_PER_SECOND=2
LLM_MAX_TOKENS=4000
LLM_TIMEOUT_SECONDS=60

# Embeddings (OpenAI, episodic memory only)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536

# Agents
AGENT_MAX_STEPS=6
AGENT_TIMEOUT_SECONDS=120

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=astra

# GCS
GCS_BUCKET=
# Full service-account JSON as one string
GCS_CREDENTIALS_JSON=

# PubMed
# Optional, raises the rate limit to 10 req/s
NCBI_API_KEY=
NCBI_EMAIL=

# Layer-Engine (empty URL = Layer features disabled)
LAYER_MCP_URL=
LAYER_API_KEY=
LAYER_COLLECTION=astra-trials
